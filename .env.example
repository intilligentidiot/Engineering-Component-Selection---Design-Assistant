# Local Environment Configuration Template
# Copy this file to .env for local development with your actual keys.
# DO NOT COMMIT .env or any real API keys to Git.

# ── Internet Discovery (Stage 6) ──────────────────────────────────────────────
SERPAPI_KEY=

# ── AI Requirement Parser (Stage 7.2) ────────────────────────────────────────
# Provider selection: 'mock' (default), 'claude', 'openai', or 'gemini'
AI_PROVIDER=mock

# Claude credentials — required only when AI_PROVIDER=claude (key from platform.claude.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — how carefully Claude thinks (higher = slower, costs more)
CLAUDE_EFFORT=medium

# OpenAI credentials — required only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini credentials — required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
